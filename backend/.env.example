# EcoTrack backend environment.
# Copy to backend/.env and edit. Real environment variables override this file.
# Every value below has a working development default, so .env is optional.

# --- Core ---------------------------------------------------------------------
# Required in any deployed environment. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=Asia/Kolkata

# --- Database -----------------------------------------------------------------
# Leave DATABASE_URL empty to use the SQLite fallback at backend/db.sqlite3.
# PostgreSQL example (requires the "postgres" extra: uv sync --extra postgres):
#   DATABASE_URL=postgres://ecotrack:ecotrack@localhost:5432/ecotrack
DATABASE_URL=
DB_CONN_MAX_AGE=60

# --- CORS / CSRF --------------------------------------------------------------
# Origins of the Vite dev server or deployed frontend.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Metadata reported by GET /api/health/ ------------------------------------
ECOTRACK_VERSION=0.1.0
ECOTRACK_ENVIRONMENT=development
